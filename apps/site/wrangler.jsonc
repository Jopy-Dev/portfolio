{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Assets-only Worker: no `main` script, so `out/_headers` applies to every
  // response and nothing runs server-side.
  "name": "portfolio",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "portfolio.jopy.dev", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
